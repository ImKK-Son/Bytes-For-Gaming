# =============================================================
# Bytes For Gaming — environment
# Only needed for the OPTIONAL affiliate feeds feature
# (server/ingest-feeds.js). A normal setup needs none of this.
#
# These map to ${ENV_VARS} referenced in feeds.config.json so your
# secrets never live in the repo. Names are examples — use whatever
# your feeds.config.json references.
# =============================================================
AFFILIATE_FEED_URL=
AFFILIATE_TOKEN=
MY_PUBLISHER_ID=
ADVERTISER_ID=
