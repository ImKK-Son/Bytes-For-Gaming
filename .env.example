# =============================================================
# Bytes For Gaming — Price API environment
# Copy to .env (local) or set these in your host's dashboard.
# =============================================================

# Live price provider key. Get a FREE key (100 searches/month) at:
#   https://serpapi.com
# Leave blank to run in mock mode (synthetic prices, no key needed).
SERPAPI_KEY=

# Which provider to use: "serpapi" (real) or "mock" (no key).
# If unset, it auto-selects: serpapi when a key is present, else mock.
PRICE_PROVIDER=

# --- standalone server (server/price-proxy.js) only ---
PORT=8787
CACHE_TTL_MIN=30
# Restrict CORS to your site's origin in production, e.g. https://yoursite.com
CORS_ORIGIN=*
